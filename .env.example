# Claude API 키 (키워드 추출 / AI 채점에 사용)
# 없으면 로컬 휴리스틱 채점으로 자동 폴백됩니다.
ANTHROPIC_API_KEY=

# 사용할 모델 (기본값: claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5

# 서버 포트 (기본값: 4000)
PORT=4000

# 문서 파싱·키워드 추출 시 Claude 동시 호출 수 (기본값: 4)
# rate limit(429)이 자주 뜨면 2로 낮추세요.
EXTRACT_CONCURRENCY=4

# 시간대 (오답노트 기간 필터가 이 시간대 기준으로 동작)
TZ=Asia/Seoul
