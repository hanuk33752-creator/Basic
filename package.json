{
  "name": "exam-quiz-app",
  "version": "1.0.0",
  "private": true,
  "description": "자격증 실기(서술형) 랜덤 출제·AI 채점 앱",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server start",
    "setup": "npm install && npm --prefix server install && npm --prefix web install",
    "seed": "node server/scripts/seed.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
